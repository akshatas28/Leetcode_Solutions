#leetcode 852 - Peak Index in Mountain Array

arr = [0,1,0] # 1
arr = [0,2,5,3,1] # 2
arr = [0,10,5,2] # 1

left = 0
right = len(arr)-1
while left < right:
    mid = (left+right)//2
    if arr[mid] < arr[mid+1]:
        left = mid+1
    else:
        right = mid
print(left) # print(right) will also work
