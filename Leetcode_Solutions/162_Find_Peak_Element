#leetcode 162 - Find Peak Element

nums = [1,2,3,1] # 2 is index
nums = [1,2,1,3,5,6,4] # 1/5
nums = [1] # 0
left = 0
right = len(nums) - 1
intfound = -1

while left <= right:
    if len(nums)==1:
        intfound=0
        break
    mid = (left + right) // 2
    if nums[mid]>nums[mid-1] and nums[mid]>nums[mid+1]:
        intfound=mid
        break
    elif nums[mid]>nums[mid-1]:
        left=mid+1
    elif nums[mid]>nums[mid+1]:
        right=mid-1
if intfound != -1:
    print(intfound)
else:
    print("0")

#leetcode 162 - Find Peak Element

nums = [1,2,3,1] # 2 is index
nums = [1,2,1,3,5,6,4] # 1/5
nums = [1] # 0
nums=[1,2]
nums = [2,1]
nums = [1,2,3,4,5]
nums = [5,4,3,2,1]
nums = [3,2,1]
nums = [2,1,3]
nums = [3,1,2]
nums = [1,3,2,4]
nums = [1,4,2,3,5]

left = 0
right = len(nums)-1

while left < right:
    mid = (left+right)//2
    if nums[mid] < nums[mid+1]:
        left = mid+1
    else:
        right = mid
print(left) # print(right) will also work
