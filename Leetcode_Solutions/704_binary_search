nums = [-1,0,3,5,9,12]
target = 9
nums = [-1,0,3,5,9,12]
target = 2
nums = [5]
target = 5

left=0
right=len(nums)-1
intfound=-1
while left<=right:
    mid=(left+right)//2
    if nums[mid]==target:
        intfound=mid
        break
    elif target<nums[mid]:
        right=mid-1
    else:
        left=mid+1
print(intfound)
