#leetcode 540 - Single Element in a Sorted Array

nums = [1,1,2,3,3,4,4,8,8]
nums=[3,3,7,7,10,11,11]

i=1
while i<len(nums):
    if nums[i]==nums[i-1] or nums[i]==nums[i+1]:
        i+=1
    else:
        print(nums[i])
        break


# second solution

nums = [1,1,2,3,3,4,4,8,8]
nums=[3,3,7,7,10,11,11]
nums = [1,2,2,3,3]
nums = [1,1,2,2,5]
nums=[1,1,2]

left = 0
right = len(nums)-1
while left < right:
    mid = (left+right)//2
    if mid % 2 == 1:
        mid -= 1
    if nums[mid]==nums[mid+1]:
        left=mid+2
    else:
        right=mid
print(nums[left])
